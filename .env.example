# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model selection (defaults to openai/gpt-4o-mini or anthropic/claude-sonnet-4)
# Recommended verified options:
# - qwen/qwen3.8-27b:free
# - google/gemma-4-26b-a4b-it:free
# - deepseek/deepseek-v4-flash-0731:free
# - nex-agi/nex-n2.5-mini:free
# - google/gemma-4-31b-it:free
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Browser Visibility Settings
# Set HEADLESS=false to watch the browser window live on your screen
HEADLESS=false
SLOW_MO_MS=400

# Security Settings
# Comma-separated list of allowed domains (or * for all)
ALLOWED_DOMAINS=*

# Max steps per run before halting
MAX_STEPS=25
