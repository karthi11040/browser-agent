// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AgentRun {
  id           String   @id @default(cuid())
  prompt       String
  mode         String   @default("general")
  status       String   @default("pending") // pending | running | completed | failed | waiting_for_confirmation
  stepsJson    String   @default("[]") // array of step objects, each with optional validations + verifications
  result       String?
  sourcesJson  String   @default("[]")
  error        String?
  // DOM-first agent additions (Phase 2/3 of the spec)
  intentJson   String?  // decomposed TaskIntent (domain hint + key terms + success pattern)
  recoveryJson String   @default("{\"state\":\"NORMAL\",\"transitions\":[]}") // recovery state machine snapshot
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// Confirmation tokens for HIGH-risk actions (Phase 3)
// Single-use, signed, scoped to one (runId, stepId, action).
model ConfirmationToken {
  id        String   @id @default(cuid())
  runId     String
  stepId    String
  action    String   // JSON of the proposed action
  intent    String?
  signature String   // HMAC of runId|stepId|action|nonce
  nonce     String
  status    String   @default("pending") // pending | approved | rejected | expired
  createdAt DateTime @default(now())
  resolvedAt DateTime?

  @@index([runId])
  @@unique([runId, stepId])
}
